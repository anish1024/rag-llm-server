environment:
    - OLLAMA_BASE_URL=http://ollama:11434
    - WEBUI_AUTH=True  # Admin only
  networks:
    - default  # Same as ollamaenvironment:
    - OLLAMA_BASE_URL=http://ollama:11434
    - WEBUI_AUTH=True  # Admin only
  networks:
    - default  # Same as ollamaenvironment:
    - OLLAMA_BASE_URL=http://ollama:11434
    - WEBUI_AUTH=True  # Admin only
  networks:
    - default  # Same as ollamaversion: '3.8'
services:
  ollama:
    image: ollama/ollama:latest
    container_name: ollama-pi5
    ports:
      - "11434:11434"
    volumes:
      - /home/ssd/ragdata/ollama:/root/.ollama
    restart: always
    environment:
      - OLLAMA_KEEP_ALIVE=30m
    healthcheck:
      test: ["CMD-SHELL", "kill -0 1 || exit 1"]  # Just check process alive
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s

  rag-agents:
    build: .
    container_name: rag-agents-pi5
    ports:
      - "8000:8000"
    volumes:
      - /home/ssd/ragdata:/home/ssd/ragdata
    depends_on:
      ollama:
        condition: service_healthy
    environment:
      - OLLAMA_BASE_URL=http://ollama:11434
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 30s

  open-webui:
    image: ghcr.io/open-webui/open-webui:main
    container_name: webui-pi5
    ports:
      - "3000:8080"
    volumes:
      - /home/ssd/ragdata/openwebui:/app/backend/data
    #environment:
    #  - OLLAMA_BASE_URL=http://host.docker.internal:11434
    depends_on:
      - ollama
    restart: always
    environment:
      - OLLAMA_BASE_URL=http://ollama:11434
      - WEBUI_AUTH=True  # Admin only
    networks:
      - default  # Same as ollama
