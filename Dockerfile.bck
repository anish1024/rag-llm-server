FROM python:3.12-slim-bookworm
WORKDIR /app
# Copy ALL code files
COPY . .
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn[standard] \
    langchain-community \
    langchain-chroma \
    chromadb \
    ollama \
    pydantic \
    numpy \
    sentence-transformers
EXPOSE 8000
CMD ["uvicorn", "agent_api:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
